MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pramalex
MYSQL_USER=root
MYSQL_PASSWORD=change_me
JWT_SECRET=replace-with-at-least-32-random-bytes
AI_SERVICE_URL=http://localhost:8000
UPLOAD_DIR=./uploads

# Optional: override the judgment corpus location used by the FastAPI service
# Windows default: D:/PramaLexData/raw/real_judgments.jsonl
# PRAMALEX_JUDGMENTS_PATH=D:/PramaLexData/raw/real_judgments.jsonl

# Optional separate Madras land corpus JSONL; does not replace the bundled 1,000-record collection
PRAMALEX_CANDIDATE_JUDGMENTS_PATH=./data/candidates/madras_land_candidates.jsonl
